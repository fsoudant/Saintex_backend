# Copier en .env et renseigner les vraies valeurs (jamais commité)

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Depuis la console Neon : Connection Details > Connection string
# Utiliser la connexion DIRECTE (non "pooled") pour les migrations.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Compte créé automatiquement au démarrage (cf. entrypoint.sh) — pas besoin
# du Shell Render, indisponible sur le palier gratuit.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=toi@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-aussi

# Mettre à "true" le temps d'un déploiement pour importer les données
# historiques (legacy_exports/), puis repasser à "false" pour ne pas
# relancer l'import à chaque redémarrage du conteneur.
RUN_LEGACY_IMPORT=false

# --- Email : code de vérification de l'inscription -----------------------------
# Par défaut (variable absente) : le message est écrit dans la console du
# serveur (logs/gunicorn.log), rien n'est envoyé — suffisant pour développer et
# pour un pilote fermé où l'on lit le code dans le log. Pour de vrais envois :
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.exemple.eu
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_DEFAULT_FROM_EMAIL=Saintex <noreply@votre-domaine>

# --- Limites de fréquence des endpoints publics (inscription, vérification) -------
# DJANGO_THROTTLE_INSCRIPTION=20/hour
# DJANGO_THROTTLE_VERIFICATION=20/hour
# Nombre de proxys inversés devant Django (Apache sur le Mac de démo : 1).
# DJANGO_NUM_PROXIES=1
